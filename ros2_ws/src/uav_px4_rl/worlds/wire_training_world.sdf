<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="wire_training_world">
    <physics name="training_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libOpticalFlowSystem.so" name="custom::OpticalFlowSystem"/>
    <plugin filename="libGstCameraSystem.so" name="custom::GstCameraSystem"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.82 0.9 1.0 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The environment relocates and rotates these fixed-length wires per episode. -->
    <model name="wire_obstacle">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name="wire_link">
        <collision name="wire_collision">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="wire_visual">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wire_obstacle_1">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name="wire_link">
        <collision name="wire_collision">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="wire_visual">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wire_obstacle_2">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name="wire_link">
        <collision name="wire_collision">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="wire_visual">
          <geometry><cylinder><radius>0.02</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_marker">
      <static>true</static>
      <pose>-4 0 1 0 0 0</pose>
      <link name="start_link">
        <visual name="start_visual">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>4 0 1 0 0 0</pose>
      <link name="goal_link">
        <visual name="goal_visual">
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
