<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_3d_lidar">
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <link name="lidar_3d_link">
      <pose relative_to="base_link">0.24 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.00008</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00008</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="lidar_3d_collision">
        <geometry>
          <box>
            <size>0.08 0.06 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="lidar_3d_visual">
        <geometry>
          <box>
            <size>0.08 0.06 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <sensor name="lidar_3d" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/x500/lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.57079632679</min_angle>
              <max_angle>1.57079632679</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.3490658504</min_angle>
              <max_angle>0.3490658504</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_3d_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_3d_link</child>
    </joint>
  </model>
</sdf>
